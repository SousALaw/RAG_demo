  "cards": [
    {
      "dot": "cyan",
      "title": "双接口共用一套逻辑",
      "items": [
        "REST API 与 Agent Tool 都只调用 RAGApp",
        "业务逻辑只在服务层实现一次，两条通道不重复",
        "Agent 通道进程内直调，不经过 HTTP"
      ]
    },
    {
      "dot": "violet",
      "title": "多数据源逻辑隔离",
      "items": [
        "5 个数据源共用一个 Chroma 集合，靠 metadata 的 category 过滤",
        "原文按 data/{category}/ 分目录，md5 去重按 (内容, 分类) 隔离",
        "加新数据源只改 config_data 里的一行；category 不是安全边界"
      ]
    },
    {
      "dot": "amber",
      "title": "部署与信任边界",
      "items": [
        "API 无鉴权，默认仅监听 127.0.0.1",
        "chroma_db/、data/、md5.text 均为本地明文状态",
        "写入必须带 category；检索可不带（跨所有源）"
      ]
    }
  ]
