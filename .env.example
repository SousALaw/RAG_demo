# 复制此文件为 .env，填入真实值
# 注意：.env 已被 .gitignore 忽略，不要把真实 Key 写回本文件

# 必填：DashScope API Key，后端与 Agent Tool 都靠它调用模型
DASHSCOPE_API_KEY=sk-your-key-here

# 选填：前端要访问的后端地址，默认 http://127.0.0.1:8000
RAG_API_BASE_URL=http://127.0.0.1:8000

# 选填：后端监听地址，默认 127.0.0.1（仅本机）
# 本服务无鉴权，改成 0.0.0.0 之前请先确认网络隔离与防火墙
RAG_API_HOST=127.0.0.1
